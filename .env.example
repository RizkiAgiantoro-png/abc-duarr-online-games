# Port Express saat dijalankan lokal. Render menyediakan PORT secara otomatis.
PORT=3000

# Kosong jika Express menyajikan frontend, atau jika pengembangan melalui proxy Vite.
# Isi dengan origin frontend (scheme + host, tanpa slash akhir), dipisah koma.
# CLIENT_ORIGINS=https://abc-duarr.example

# Hanya untuk frontend dan backend yang dihosting terpisah. Dipakai saat Vite build.
# VITE_SOCKET_URL=https://abc-duarr-api.example
